allowHTML: true
apply-presets: true
varsPreset: public
langs: [ru, en]
allow-custom-resources: true
breaks: false
search-by-toc: true

docs-viewer:
  project-name: ytsaurus-core
  show-revision: true
  langs: [ru, en]
  themes: [light, dark]
  github-url-prefix: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/core
  index-page:
    hidden: true
    title: YTsaurus Core
    description: Core YTsaurus platform documentation

vcs:
  remoteBase: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/core
  enabled: true
