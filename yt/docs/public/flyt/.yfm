allowHTML: true
apply-presets: true
varsPreset: public
langs: [ru, en]
allow-custom-resources: true
resources:
  - _assets/navigation/github.svg
  - _assets/navigation/logo-dark.svg
  - _assets/navigation/logo-light.svg
breaks: false
search-by-toc: true

docs-viewer:
  project-name: flyt
  show-revision: true
  langs: [ru, en]
  themes: [light, dark]
  github-url-prefix: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/flyt
  index-page:
    hidden: true
    title: YTsaurus FLYT
    description: Apache Flink integration with YTsaurus

search:
  provider: local

vcs:
  remoteBase: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/flyt
  enabled: true
