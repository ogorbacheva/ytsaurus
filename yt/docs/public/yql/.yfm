allowHTML: true
apply-presets: true
varsPreset: public
langs: [ru, en]
allow-custom-resources: true
breaks: false
search-by-toc: true

docs-viewer:
  project-name: yql
  show-revision: true
  langs: [ru, en]
  themes: [light, dark]
  github-url-prefix: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/yql
  index-page:
    hidden: true
    title: YQL
    description: YQL over YTsaurus

search:
  provider: local

vcs:
  remoteBase: https://github.com/ytsaurus/ytsaurus/tree/main/yt/docs/public/yql
  enabled: true
